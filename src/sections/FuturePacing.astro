---
/**
 * "Imagine" headline, three paragraphs and the drag-to-compare slider.
 * Slider left of the text on desktop; on phones the headline, then the
 * slider, then the paragraphs. Holds 1 to 4 paragraphs.
 */
import type { FuturePacingContent } from '../config/types.ts';
import type { Tone } from '../lib/sections.ts';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Cta from '../components/Cta.astro';
import CompareSlider from '../components/CompareSlider.astro';

interface Props {
  content: FuturePacingContent;
  tone: Tone;
  id?: string;
  ctaLabel?: string;
}
const { content, tone, id, ctaLabel } = Astro.props;
---

<Section tone={tone} type="futurePacing" id={id}>
  <Container>
    <div class="future">
      <h2 class="h2 future__headline">{content.headline}</h2>
      <div class="future__slider">
        <CompareSlider
          before={content.before}
          after={content.after}
          beforeLabel={content.beforeLabel}
          afterLabel={content.afterLabel}
          slotPrefix="futurePacing"
        />
      </div>
      <div class="future__text">
        {content.paragraphs.map((p) => (
          <p class="future__p">{p}</p>
        ))}
      </div>
      <Cta label={ctaLabel} align="start" wide={false} class="future__cta" />
    </div>
  </Container>
</Section>

<style>
  .future {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-inline: 20px;
  }

  .future__headline {
    text-align: left;
  }

  .future__text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .future__cta {
    margin-top: 10px;
  }

  @media (min-width: 1024px) {
    .future {
      display: grid;
      grid-template-columns: 530px 1fr;
      grid-template-areas:
        'slider headline'
        'slider text'
        'slider cta';
      grid-template-rows: auto auto 1fr;
      column-gap: var(--gap-column);
      row-gap: 20px;
      align-items: start;
      max-width: 1100px;
      margin-inline: auto;
      padding-inline: 0;
      padding-block: 100px; /* the reference leaves this much air around the slider on desktop */
    }

    .future__headline {
      grid-area: headline;
    }

    .future__slider {
      grid-area: slider;
      align-self: center;
    }

    .future__text {
      grid-area: text;
      font-size: 17px;
      line-height: 1.4;
    }

    .future__cta {
      grid-area: cta;
      margin-top: 30px;
    }
  }
</style>
