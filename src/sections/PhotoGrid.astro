---
/**
 * Full-bleed strip of square job photos: 2x2 on phones, one row on desktop.
 * Holds 2 to 8 images (4 or 8 look best). Inherits the tone of the section above.
 */
import type { PhotoGridContent } from '../config/types.ts';
import type { Tone } from '../lib/sections.ts';
import { imageSpecs } from '../tokens/tokens.ts';
import Section from '../components/Section.astro';
import ImageSlot from '../components/ImageSlot.astro';

interface Props {
  content: PhotoGridContent;
  tone: Tone;
  id?: string;
}
const { content, tone, id } = Astro.props;
const count = content.images.length;
---

<Section tone={tone} type="photoGrid" id={id} padding="none" class="grid-strip">
  <ul class="grid-strip__grid reveal reveal--none" style={`--count:${count}`}>
    {content.images.map((image, i) => (
      <li class="grid-strip__tile">
        <ImageSlot
          image={image}
          slotId={`photoGrid.images[${i}]`}
          spec={imageSpecs.gridTile}
          description="square job photo"
          widths={[191, 349, 382, 698]}
          sizes="(min-width: 1024px) 25vw, 50vw"
          class="grid-strip__img"
        />
      </li>
    ))}
  </ul>
</Section>

<style>
  .grid-strip__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-grid);
  }

  .grid-strip__tile {
    aspect-ratio: 1;
    overflow: hidden;
  }

  .grid-strip__tile :global(.grid-strip__img),
  .grid-strip__tile :global(.slot) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  @media (min-width: 1024px) {
    .grid-strip__grid {
      grid-template-columns: repeat(min(var(--count), 4), minmax(0, 1fr));
    }
  }
</style>
