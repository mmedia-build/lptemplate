---
/**
 * Named guarantee: shield badge drawn from the badge lines, headline,
 * optional sub-headline, plain-language terms in a narrow centred column,
 * an optional decorative image between the paragraphs and an optional
 * "terms apply" button that opens the terms modal.
 */
import type { GuaranteeContent } from '../config/types.ts';
import type { Tone } from '../lib/sections.ts';
import { site } from '../lib/site.ts';
import { imageSpecs } from '../tokens/tokens.ts';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import ImageSlot from '../components/ImageSlot.astro';

interface Props {
  content: GuaranteeContent;
  tone: Tone;
  id?: string;
}
const { content, tone, id } = Astro.props;
const line1 = content.badgeLine1.split(' ');
const line1a = line1.length > 1 ? line1.slice(0, Math.ceil(line1.length / 2)).join(' ') : content.badgeLine1;
const line1b = line1.length > 1 ? line1.slice(Math.ceil(line1.length / 2)).join(' ') : '';
const line3 = (content.badgeLine3 || '').trim();
// A long second line (reference B's "in under 42 days or we pay you $3k") wraps onto two smaller lines inside the shield.
const line2Words = content.badgeLine2.split(' ');
const line2Long = content.badgeLine2.length > 16 && line2Words.length > 1;
const line2a = line2Long ? line2Words.slice(0, Math.ceil(line2Words.length / 2)).join(' ') : content.badgeLine2;
const line2b = line2Long ? line2Words.slice(Math.ceil(line2Words.length / 2)).join(' ') : '';
const line2Size = line2Long ? 12 : 16;
const subheadline = (content.subheadline || '').trim();
const decorative = content.decorativeImage?.src ? content.decorativeImage : undefined;
// The decorative image sits after the fourth paragraph (or after the last when there are fewer).
const splitAt = Math.min(4, content.paragraphs.length);
const firstRun = content.paragraphs.slice(0, splitAt);
const secondRun = content.paragraphs.slice(splitAt);
const badgeLabel = [content.badgeLine1, content.badgeLine2, line3].filter(Boolean).join(' ');
---

<Section tone={tone} type="guarantee" id={id}>
  <Container narrow>
    <div class="guarantee">
      <svg class="guarantee__badge" viewBox="0 0 220 265" width="220" height="265" role="img" aria-label={badgeLabel}>
        <path d="M110 6 20 36v92c0 57 38 108 90 128 52-20 90-71 90-128V36L110 6Z" fill="none" stroke="var(--colour-accent)" stroke-width="5" stroke-linejoin="round" />
        <path d="M110 22 34 47v81c0 49 32 93 76 111 44-18 76-62 76-111V47L110 22Z" fill="none" stroke="var(--colour-accent)" stroke-width="2" stroke-linejoin="round" />
        <g fill="var(--colour-accent)">
          <path d="m110 56 4.6 9.4 10.4 1.5-7.5 7.3 1.8 10.3L110 79.6l-9.3 4.9 1.8-10.3-7.5-7.3 10.4-1.5L110 56Z" />
          <path d="m82 66 3.4 6.9 7.6 1.1-5.5 5.4 1.3 7.6L82 83.4l-6.8 3.6 1.3-7.6-5.5-5.4 7.6-1.1L82 66Z" />
          <path d="m138 66 3.4 6.9 7.6 1.1-5.5 5.4 1.3 7.6-6.8-3.6-6.8 3.6 1.3-7.6-5.5-5.4 7.6-1.1L138 66Z" />
        </g>
        <path d="M60 100h100" stroke="var(--colour-accent)" stroke-width="2" />
        <text x="110" y="128" text-anchor="middle" font-family="var(--font-heading)" font-size="22" font-weight="600" fill="var(--colour-heading)" letter-spacing="0.5">{line1a.toUpperCase()}</text>
        {line1b && (
          <text x="110" y="154" text-anchor="middle" font-family="var(--font-heading)" font-size="22" font-weight="600" fill="var(--colour-heading)" letter-spacing="0.5">{line1b.toUpperCase()}</text>
        )}
        <circle cx="110" cy="172" r="3" fill="var(--colour-accent)" />
        <path d="M70 172h32M118 172h32" stroke="var(--colour-accent)" stroke-width="1.5" />
        <text x="110" y={line2Long ? 194 : 200} text-anchor="middle" font-family="var(--font-heading)" font-size={line2Size} font-weight="600" fill="var(--colour-heading)">{line2a.toUpperCase()}</text>
        {line2b && (
          <text x="110" y="210" text-anchor="middle" font-family="var(--font-heading)" font-size={line2Size} font-weight="600" fill="var(--colour-heading)">{line2b.toUpperCase()}</text>
        )}
        {line3 && (
          <text x="110" y={line2Long ? 232 : 224} text-anchor="middle" font-family="var(--font-heading)" font-size="12" font-weight="600" fill="var(--colour-accent-text)" letter-spacing="1">{line3.toUpperCase()}</text>
        )}
      </svg>
      <h2 class="h2 text-center guarantee__headline">{content.headline}</h2>
      {subheadline && <h3 class="guarantee__subheadline text-center">{subheadline}</h3>}
      <div class="guarantee__text">
        {firstRun.map((p) => (
          <p>{p}</p>
        ))}
        {decorative && (
          <div class="guarantee__decorative" aria-hidden="true">
            <ImageSlot
              image={decorative}
              slotId="guarantee.decorativeImage"
              spec={imageSpecs.decorative}
              description="line drawing or diagram on transparent"
              widths={[308, 474, 616, 948]}
              sizes="(min-width: 1024px) 474px, calc(100vw - 80px)"
              class="guarantee__decorative-img"
              placeholder={false}
            />
          </div>
        )}
        {secondRun.map((p) => (
          <p>{p}</p>
        ))}
        {content.termsLink && (
          <p>
            <button type="button" class="guarantee__terms" data-open-modal="terms">{site.legal.terms.label} apply</button>
          </p>
        )}
      </div>
    </div>
  </Container>
</Section>

<style>
  .guarantee {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .guarantee__badge {
    width: 220px;
    height: 265px;
  }

  .guarantee__headline {
    max-width: 400px;
  }

  .guarantee__subheadline {
    font-size: var(--fs-h3-guarantee);
    line-height: var(--lh-h3-guarantee);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.02em;
  }

  .guarantee__text {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }

  .guarantee__decorative {
    display: flex;
    justify-content: center;
    padding: 12px 0;
  }

  .guarantee__decorative :global(.guarantee__decorative-img) {
    width: min(100%, 474px);
    height: auto;
  }

  .guarantee__terms {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .guarantee__text {
      font-size: 17px;
      line-height: 1.4;
    }
  }
</style>
