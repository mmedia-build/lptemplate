---
/**
 * Hero: qualifying eyebrow, offer headline, supporting paragraph, CTA and
 * review badge over a washed-out job photo. Everything above the fold at
 * 390x664. The image is eager, preloaded and never lazy.
 */
import type { HeroContent } from '../config/types.ts';
import { site } from '../lib/site.ts';
import { imageSpecs } from '../tokens/tokens.ts';
import Section from '../components/Section.astro';
import Container from '../components/Container.astro';
import Cta from '../components/Cta.astro';
import ImageSlot from '../components/ImageSlot.astro';
import VideoTile from '../components/VideoTile.astro';

interface Props {
  content: HeroContent;
  id?: string;
  ctaLabel?: string;
}
const { content, id, ctaLabel } = Astro.props;
const wash = Math.min(1, Math.max(0, site.brand.heroWash));
const band = content.imageLayout === 'band';
const video = content.imageLayout === 'video';
const urgency = video && content.showUrgency ? site.urgency.line.trim() : '';
---

{video ? (
<Section tone="hero" type="hero" id={id} padding="none" class="hero hero--video">
  <Container class="hero__content">
    <p class="hero__pill">{content.eyebrow}</p>
    <h1 class="h1 hero__headline">
      {content.headline}
      {content.headlineAccent && <>{' '}<span class="hero__accent">{content.headlineAccent}</span></>}
    </h1>
    <p class="hero__body hero__guarantee">{content.body}</p>
    <div class="hero__video">
      <VideoTile
        poster={content.video?.poster ?? { src: '', alt: '' }}
        videoUrl={content.video?.videoUrl ?? ''}
        slotId="hero.video.poster"
        label={content.video?.caption || content.headline}
        shape="landscape"
        spec={imageSpecs.heroVideoPoster}
        description="16:9 poster frame of the explainer, presenter visible, face out of the centre"
        widths={[390, 780, 870, 1600]}
        sizes="(min-width: 1024px) 870px, calc(100vw - 32px)"
        title={content.video?.label}
        caption={content.video?.caption}
        priority
      />
    </div>
    <Cta label={ctaLabel} class="hero__cta" />
    {urgency && (
      <p class="hero__status"><span class="hero__dot" aria-hidden="true"></span>{urgency}</p>
    )}
  </Container>
</Section>
) : (

<Section tone="hero" type="hero" id={id} padding="none" class:list={['hero', band && 'hero--band']}>
  <div class="hero__bg" aria-hidden="true">
    <ImageSlot
      image={content.image}
      slotId="hero.image"
      spec={imageSpecs.heroBackground}
      description="wide finished job at dusk, house visible, no people"
      priority
      picture
      widths={[480, 780, 1024, 1440, 2048, 2400]}
      sizes="100vw"
      class="hero__img"
      labelPosition="bottom"
    />
    <div class="hero__wash" style={`opacity:${wash}`}></div>
  </div>
  <Container class="hero__content">
    <p class="eyebrow hero__eyebrow">{content.eyebrow}</p>
    <h1 class="h1 hero__headline">{content.headline}</h1>
    <p class="hero__body">{content.body}</p>
    <Cta label={ctaLabel} class="hero__cta" />
  </Container>
</Section>
)}

<style>
  .hero {
    padding-top: var(--hero-pad-top);
    padding-bottom: var(--hero-pad-bottom);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg :global(.hero__img),
  .hero__bg :global(.slot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .hero__bg :global(.slot__label) {
    font-size: 10px;
    line-height: 1.2;
    padding: 4px 8px;
    text-align: left;
  }

  .hero__wash {
    position: absolute;
    inset: 0;
    background: var(--colour-surface);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__eyebrow {
    margin-bottom: 20px;
  }

  .hero__headline {
    max-width: 1000px;
    margin-bottom: 20px;
  }

  .hero__body {
    max-width: 740px;
    margin-bottom: 30px;
  }

  /* Band layout (reference B on phones): flat surface behind the text, the photo as a band under the CTA. */
  @media (max-width: 1023px) {
    .hero--band {
      display: flex;
      flex-direction: column;
      padding-top: 88px;
      padding-bottom: 0;
    }

    /* Reference B's eyebrow is smaller and tighter than A's, which keeps a 375 character paragraph on the first screen. */
    .hero--band .hero__eyebrow {
      font-size: 12px;
      letter-spacing: 0.08em;
      margin-bottom: 14px;
    }

    .hero--band .hero__headline {
      margin-bottom: 14px;
    }

    .hero--band .hero__body {
      margin-bottom: 20px;
    }

    .hero--band .hero__bg {
      position: relative;
      inset: auto;
      order: 2;
      margin-top: var(--hero-pad-bottom);
    }

    .hero--band .hero__bg :global(.hero__img),
    .hero--band .hero__bg :global(.slot) {
      position: relative;
      height: auto;
      aspect-ratio: 6 / 5;
      object-fit: cover;
    }

    .hero--band .hero__wash {
      display: none;
    }

    .hero--band .hero__content {
      order: 1;
    }
  }

  @media (min-width: 1024px) {
    .hero__body {
      font-size: 17px;
      line-height: 1.4;
    }
  }

  /*
    Video layout (reference C). Near-black surface, everything centred. Measured from C and
    tightened so eyebrow, headline, guarantee line, video, CTA and the line beneath end inside
    664 px at 390 wide (C's own CTA starts at 641 and is cut off; see docs/decisions.md).
  */
  .hero--video {
    --colour-heading: var(--colour-on-night);
    --colour-body: var(--colour-on-night);
    background: var(--colour-night);
    color: var(--colour-on-night);
    padding-top: 68px;
    padding-bottom: 28px;
  }

  .hero--video .hero__content {
    gap: 0;
  }

  .hero__pill {
    max-width: 100%;
    margin-bottom: 14px;
    padding: 7px 14px 6px;
    font-size: 12px;
    line-height: 1.35;
    font-weight: var(--weight-bold);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--colour-on-primary);
    background: var(--colour-primary);
    border: 1px solid var(--colour-on-primary);
    border-radius: 40px;
  }

  .hero--video .hero__headline {
    max-width: 950px;
    margin-bottom: 10px;
    font-size: 34px;
    line-height: 1.06;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.032em;
  }

  .hero__accent {
    display: block;
    color: var(--colour-highlight);
  }

  .hero__guarantee {
    max-width: 560px;
    margin-bottom: 16px;
    font-size: 17px;
    line-height: 1.35;
    font-weight: var(--weight-semibold);
    opacity: 0.92;
  }

  .hero__video {
    width: 100%;
    max-width: 870px;
    margin-bottom: 16px;
    padding: 1px;
    background: #454545;
    border-radius: var(--radius-media);
  }

  .hero__video :global(.video) {
    border-radius: calc(var(--radius-media) - 1px);
  }

  .hero--video :global(.hero__cta .btn) {
    min-height: 56px;
    font-size: 19px;
  }

  .hero__status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.4;
    font-weight: var(--weight-medium);
  }

  .hero__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--colour-highlight);
  }

  @media (min-width: 1024px) {
    .hero--video {
      padding-top: 116px;
      padding-bottom: 56px;
    }

    .hero__pill {
      margin-bottom: 26px;
      padding: 12px 20px 11px;
      font-size: 16px;
    }

    .hero--video .hero__headline {
      margin-bottom: 18px;
      font-size: 58px;
      line-height: 1.08;
    }

    .hero__guarantee {
      margin-bottom: 34px;
      font-size: 20px;
    }

    .hero__video {
      margin-bottom: 32px;
    }

    .hero--video :global(.hero__cta .btn) {
      min-width: 370px;
      min-height: 77px;
      font-size: 22px;
    }

    .hero__status {
      margin-top: 20px;
      font-size: 16px;
    }
  }
</style>
