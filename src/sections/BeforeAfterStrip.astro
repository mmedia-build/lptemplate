---
/**
 * Before and after pairs in a continuous CSS marquee, full bleed, no padding.
 * Holds 3 to 12 pairs; fewer pairs get more copies so the loop stays seamless.
 */
import type { BeforeAfterContent } from '../config/types.ts';
import type { Tone } from '../lib/sections.ts';
import { imageSpecs } from '../tokens/tokens.ts';
import Section from '../components/Section.astro';
import Marquee from '../components/Marquee.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Icon from '../components/Icon.astro';

interface Props {
  content: BeforeAfterContent;
  tone: Tone;
  id?: string;
}
const { content, tone, id } = Astro.props;
const pairs = content.pairs;
const copies = pairs.length >= 6 ? 2 : pairs.length >= 3 ? 3 : 5;
const duration = Math.max(20, Math.round(pairs.length * 8.6));
---

<Section tone={tone} type="beforeAfter" id={id} padding="none" class="ba">
  <Marquee duration={duration} direction={content.direction} gap="12px" copies={copies} label="Before and after photos">
    {pairs.map((pair, i) => (
      <div class="ba__pair">
        <figure class="ba__tile">
          <ImageSlot
            image={pair.before}
            slotId={`beforeAfter.pairs[${i}].before`}
            spec={imageSpecs.beforeAfterTile}
            description="before, portrait, same spot as the after"
            widths={[234, 468, 702]}
            sizes="234px"
            class="ba__img"
          />
          <figcaption class="ba__tag ba__tag--before">
            <Icon ui="cross" size={12} strokeWidth={2.5} class="ba__tag-icon ba__tag-icon--before" />
            {content.beforeLabel}
          </figcaption>
        </figure>
        <figure class="ba__tile">
          <ImageSlot
            image={pair.after}
            slotId={`beforeAfter.pairs[${i}].after`}
            spec={imageSpecs.beforeAfterTile}
            description="after, portrait, matched framing"
            widths={[234, 468, 702]}
            sizes="234px"
            class="ba__img"
          />
          <figcaption class="ba__tag ba__tag--after">
            <Icon ui="check" size={12} strokeWidth={2.5} class="ba__tag-icon ba__tag-icon--after" />
            {content.afterLabel}
          </figcaption>
        </figure>
      </div>
    ))}
  </Marquee>
</Section>

<style>
  .ba__pair {
    display: grid;
    grid-template-columns: 234px 234px;
    gap: 2px;
    flex: none;
    background: var(--colour-surface);
  }

  .ba__tile {
    position: relative;
    width: 234px;
    height: 311px;
    overflow: hidden;
  }

  .ba__tile :global(.ba__img),
  .ba__tile :global(.slot) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .ba__tag {
    position: absolute;
    top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 7px;
    background: var(--colour-surface);
    color: var(--colour-heading);
    font-size: 16px;
    line-height: 1;
    font-weight: var(--weight-semibold);
  }

  .ba__tag--before {
    left: 8px;
  }

  .ba__tag--after {
    right: 8px;
  }

  .ba__tag-icon {
    border-radius: var(--radius-pill);
    padding: 1px;
    color: #fff;
  }

  .ba__tag-icon--before {
    background: var(--colour-danger);
  }

  .ba__tag-icon--after {
    background: var(--colour-primary);
  }

  @media (min-width: 1024px) {
    .ba__pair {
      grid-template-columns: 235px 235px;
    }

    .ba__tile {
      width: 235px;
      height: 314px;
    }

    .ba__tag-icon {
      width: 16px;
      height: 16px;
    }
  }
</style>
