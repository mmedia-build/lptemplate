---
/**
 * Quiz funnel (reference C). The whole page in one section: an intro screen,
 * then one question per screen, the contact step, a loader and the hand-off
 * to the thank-you route. Behaviour lives in src/scripts/quiz.ts; this file is
 * markup and measured layout only. Every step is rendered in the HTML and all
 * but the active one are hidden and inert, so the page works as plain markup
 * and nothing is injected by script.
 */
import type { QuizContent, QuizOption, QuizStep } from '../config/types.ts';
import type { Tone } from '../lib/sections.ts';
import { site } from '../lib/site.ts';
import { imageSpecs } from '../tokens/tokens.ts';
import GuideNote from '../components/GuideNote.astro';
import Icon from '../components/Icon.astro';
import ImageSlot from '../components/ImageSlot.astro';

interface Props {
  content: QuizContent;
  tone: Tone;
  id?: string;
  ctaLabel?: string;
}
const { content, id = 'quiz' } = Astro.props;
const { intro, steps, contact, loader, exitPrompt } = content;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
/** Escapes text and turns {name} or {name|Fallback} into a span the script fills with the first name. */
const fmt = (text: string) => {
  let out = '';
  let last = 0;
  const re = /\{name(?:\|([^}]*))?\}/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text))) {
    const before = text.slice(last, m.index);
    out += esc(before);
    const lead = /\S$/.test(text.slice(0, m.index)) ? '1' : '0';
    const fallback = m[1] ?? '';
    out += `<span data-quiz-name data-lead="${lead}" data-fallback="${esc(fallback)}">${esc(fallback)}</span>`;
    last = m.index + m[0].length;
  }
  return out + esc(text.slice(last));
};
const val = (o: QuizOption) => o.value ?? o.label;

/** Scale buttons step from neutral grey to the brand colour, so the top of the scale looks like the button. */
const hex = (h: string) => {
  const c = h.replace('#', '');
  const f = c.length === 3 ? c.split('').map((x) => x + x).join('') : c;
  return [0, 2, 4].map((i) => parseInt(f.slice(i, i + 2), 16));
};
const primaryHex = site.brand.colours.primary || '#224b1c';
const onPrimary = site.brand.colours['on-primary'] || '#ffffff';
const mix = (t: number) => {
  const a = [230, 230, 230];
  const b = hex(primaryHex);
  return `rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * t)).join(' ')})`;
};
const lum = (rgb: number[]) => {
  const [r, g, b] = rgb.map((v) => {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const scaleText = (t: number) => {
  const a = [230, 230, 230];
  const b = hex(primaryHex);
  const bg = a.map((v, i) => Math.round(v + (b[i] - v) * t));
  const L = lum(bg);
  const dark = (L + 0.05) / 0.05;
  const light = 1.05 / (L + 0.05);
  // Dark text unless the brand colour is dark enough that the configured on-primary colour reads better.
  return dark >= light ? '#1a1a1a' : onPrimary;
};

const runtime = {
  steps: steps.map((s: QuizStep) => ({
    name: s.name,
    kind: s.kind,
    minLength: 'minLength' in s ? s.minLength : undefined,
    scoreAny: s.kind === 'multi' ? s.scoreAny : undefined,
    disqualifyAtOrBelow: s.kind === 'scale' ? s.disqualifyAtOrBelow : undefined,
    scoreBands: s.kind === 'scale' ? s.scoreBands : undefined,
    otherOption: s.kind === 'select' ? s.otherOption : undefined,
  })),
  contact: contact.fields.map((f) => ({ name: f.name, type: f.type, required: f.required, prefillFrom: f.prefillFrom })),
  dots: content.progressDots,
  messages: content.messages,
  destination: site.form.destination,
  thankYouPath: site.form.thankYouPath,
  notFitPath: content.notFitPath,
  capturePartial: content.capturePartial,
  loader: { enabled: loader.enabled, durationMs: loader.durationMs },
  qualifiedLeadScore: site.tracking.qualifiedLeadScore ?? null,
};
const total = steps.length + 1;
---

<section id={id} class="quiz" data-section="quiz" data-quiz data-quiz-config={JSON.stringify(runtime)}>
  <GuideNote type="quiz" />
  <div class="quiz__inner">
    <ol class="quiz__progress" data-quiz-progress aria-hidden="true">
      {Array.from({ length: content.progressDots }).map(() => <li />)}
    </ol>
    <p class="visually-hidden" role="status" data-quiz-status data-template={`Question {n} of ${total}`}></p>

    <form class="quiz__form" novalidate data-quiz-form>
      <div class="quiz__step quiz__step--intro is-active" data-step="intro">
        {intro.eyebrow && <p class="quiz__eyebrow">{intro.eyebrow}</p>}
        <h1 class="quiz__headline">{intro.headline}</h1>
        <p class="quiz__lede">{intro.body}</p>
        <button type="button" class="quiz__btn quiz__btn--start" data-quiz-start>
          <span>{Astro.props.ctaLabel || intro.cta}</span>
          <svg class="quiz__arrow" width="40" height="25" viewBox="0 0 40 25" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12.5h33"/><path d="m26.5 3 9.5 9.5-9.5 9.5"/></svg>
        </button>
      </div>

      {steps.map((step, i) => {
        const qid = `q-${step.name}`;
        const errId = `e-${step.name}`;
        const needsContinue = ['text', 'email', 'longtext', 'multi', 'select'].includes(step.kind);
        return (
          <div class:list={['quiz__step', `quiz__step--${step.kind}`]} data-step={step.name} data-kind={step.kind} data-index={i + 1} hidden inert>
            {step.pill && <p class="quiz__pill" set:html={fmt(step.pill)} />}
            <h2 class:list={['quiz__question', (step.sub || step.note) && 'quiz__question--tight']} id={qid} tabindex="-1" set:html={fmt(step.question)} />
            {step.sub && <p class="quiz__sub" set:html={fmt(step.sub)} />}
            {step.note && <p class="quiz__note" set:html={fmt(step.note)} />}

            {(step.kind === 'text' || step.kind === 'email') && (
              <div class="quiz__field" data-field={step.name}>
                <label class="visually-hidden" for={`i-${step.name}`}>{step.label}</label>
                <input
                  class="quiz__input"
                  id={`i-${step.name}`}
                  name={step.name}
                  type={step.kind === 'email' ? 'email' : 'text'}
                  placeholder={step.placeholder}
                  autocomplete={step.kind === 'email' ? 'email' : (step.autocomplete ?? 'off')}
                  inputmode={step.kind === 'email' ? 'email' : (step.inputmode ?? undefined)}
                  autocapitalize={step.kind === 'email' || step.inputmode === 'url' ? 'off' : undefined}
                  autocorrect={step.kind === 'email' || step.inputmode === 'url' ? 'off' : undefined}
                  spellcheck={step.kind === 'email' || step.inputmode === 'url' ? 'false' : undefined}
                  aria-describedby={errId}
                  required
                />
                <p class="quiz__error" id={errId} aria-live="polite"></p>
              </div>
            )}

            {step.kind === 'longtext' && (
              <div class="quiz__field quiz__field--wide" data-field={step.name}>
                <label class="visually-hidden" for={`i-${step.name}`}>{step.label}</label>
                <div class="quiz__textarea-wrap">
                  <textarea class="quiz__textarea" id={`i-${step.name}`} name={step.name} rows={step.rows ?? 5} placeholder={step.placeholder} aria-describedby={errId} required></textarea>
                  {step.dictateLabel && (
                    <button type="button" class="quiz__dictate" data-dictate aria-pressed="false" hidden>
                      <span class="quiz__dictate-mic"><Icon ui="mic" size={18} strokeWidth={2} /></span>
                      <span class="quiz__dictate-label" data-dictate-label>{step.dictateLabel}</span>
                      <span class="quiz__dictate-timer" data-dictate-timer aria-hidden="true"></span>
                    </button>
                  )}
                </div>
                <p class="quiz__error" id={errId} aria-live="polite"></p>
              </div>
            )}

            {step.kind === 'cards' && (
              <div class="quiz__cards" role="radiogroup" aria-labelledby={qid}>
                {step.options.map((o, n) => (
                  <div class="quiz-card">
                    <input class="quiz__radio" type="radio" name={step.name} id={`o-${step.name}-${n}`} value={val(o)} data-score={o.score} data-disqualify={o.disqualify ? '1' : undefined} data-advance />
                    <label for={`o-${step.name}-${n}`}>
                      <span class="quiz-card__icon"><Icon name={o.icon ?? 'target'} size={26} /></span>
                      <span class="quiz-card__text">
                        <span class="quiz-card__title">{o.label}</span>
                        {o.description && <span class="quiz-card__desc">{o.description}</span>}
                      </span>
                      <Icon ui="chevronRight" size={20} strokeWidth={2} class="quiz-card__chevron" />
                    </label>
                  </div>
                ))}
              </div>
            )}

            {step.kind === 'choice' && (
              <div class="quiz__pills" role="radiogroup" aria-labelledby={qid}>
                {step.options.map((o, n) => (
                  <div class="quiz-pill">
                    <input class="quiz__radio" type="radio" name={step.name} id={`o-${step.name}-${n}`} value={val(o)} data-score={o.score} data-disqualify={o.disqualify ? '1' : undefined} data-advance />
                    <label for={`o-${step.name}-${n}`}>
                      <span class="quiz-pill__dot" aria-hidden="true"><Icon ui="check" size={16} strokeWidth={3} /></span>
                      <span>{o.label}</span>
                    </label>
                  </div>
                ))}
              </div>
            )}

            {step.kind === 'multi' && (
              <div class="quiz__multi" role="group" aria-labelledby={qid}>
                {step.options.map((o, n) => (
                  <div class="quiz-tick">
                    <input class="quiz__radio" type="checkbox" name={step.name} id={`o-${step.name}-${n}`} value={val(o)} data-score={o.score} />
                    <label for={`o-${step.name}-${n}`}>
                      <span class="quiz-tick__icons">
                        <span class="quiz-tick__icon"><Icon name={o.icon ?? 'target'} size={24} /></span>
                        {o.icon2 && <span class="quiz-tick__icon"><Icon name={o.icon2} size={24} /></span>}
                      </span>
                      <span class="quiz-tick__label">{o.label}</span>
                      <span class="quiz-tick__check" aria-hidden="true"><Icon ui="check" size={12} strokeWidth={3.5} /></span>
                    </label>
                  </div>
                ))}
              </div>
            )}

            {step.kind === 'select' && (
              <div class="quiz__field" data-field={step.name}>
                <label class="visually-hidden" for={`i-${step.name}`}>{step.label}</label>
                <div class="quiz__select-wrap">
                  <select class="quiz__input quiz__select" id={`i-${step.name}`} name={step.name} aria-describedby={errId} required>
                    <option value="" disabled selected={!step.preselect}>{step.prompt}</option>
                    {step.options.map((o, n) => (
                      <option value={val(o)} selected={step.preselect === val(o)} data-score={o.score} data-disqualify={o.disqualify ? '1' : undefined}>{o.label}</option>
                    ))}
                    {step.otherOption && <option value={step.otherOption} data-other="1">{step.otherOption}</option>}
                  </select>
                  <Icon ui="chevron-down" size={20} strokeWidth={2} class="quiz__select-chevron" />
                </div>
                {step.otherOption && (
                  <input class="quiz__input quiz__other" type="text" name={`${step.name}_other`} placeholder={step.otherPlaceholder ?? ''} aria-label={step.otherPlaceholder ?? step.otherOption} hidden />
                )}
                <p class="quiz__error" id={errId} aria-live="polite"></p>
              </div>
            )}

            {step.kind === 'scale' && (
              <div class="quiz__scale" role="radiogroup" aria-labelledby={qid}>
                {Array.from({ length: step.max - step.min + 1 }).map((_, n) => {
                  const v = step.min + n;
                  const t = n / Math.max(1, step.max - step.min);
                  return (
                    <div class="quiz-num">
                      <input class="quiz__radio" type="radio" name={step.name} id={`o-${step.name}-${v}`} value={String(v)} data-advance />
                      <label for={`o-${step.name}-${v}`} style={`background:${mix(t)};color:${scaleText(t)}`}>{v}</label>
                    </div>
                  );
                })}
              </div>
            )}

            {step.kind === 'yesno' && (
              <div class="quiz__yesno" role="radiogroup" aria-labelledby={qid}>
                {step.options.map((o, n) => (
                  <div class="quiz-emoji">
                    <input class="quiz__radio" type="radio" name={step.name} id={`o-${step.name}-${n}`} value={val(o)} data-score={o.score} data-disqualify={o.disqualify ? '1' : undefined} data-advance />
                    <label for={`o-${step.name}-${n}`}>
                      {o.emoji && <span class="quiz-emoji__glyph" aria-hidden="true">{o.emoji}</span>}
                      <span>{o.label}</span>
                    </label>
                  </div>
                ))}
              </div>
            )}

            {step.kind === 'offers' && (
              <div class="quiz__offers" role="radiogroup" aria-labelledby={qid}>
                {step.offers.map((o, n) => (
                  <div class="quiz-offer">
                    <input class="quiz__radio" type="radio" name={step.name} id={`o-${step.name}-${n}`} value={o.value} data-score={o.score} data-disqualify={o.disqualify ? '1' : undefined} data-advance />
                    <label for={`o-${step.name}-${n}`}>
                      <span class="quiz-offer__mark" aria-hidden="true"><Icon name={o.icon ?? 'target'} size={44} strokeWidth={2} /></span>
                      <span class="quiz-offer__eyebrow">{o.eyebrow}</span>
                      <span class="quiz-offer__title">{o.title}</span>
                      <span class="quiz-offer__desc">{o.description}</span>
                      <span class="quiz-offer__cta">{o.cta}</span>
                      {o.proofImage && (
                        <span class="quiz-offer__proof">
                          <ImageSlot image={o.proofImage} slotId={`quiz.${step.name}.offers[${n}].proofImage`} spec={imageSpecs.offerProof} description="row of client logos or faces" widths={[250, 500]} sizes="250px" labelPosition="center" />
                        </span>
                      )}
                      {o.proofLine && <span class="quiz-offer__line">{o.proofLine}</span>}
                    </label>
                  </div>
                ))}
              </div>
            )}

            {needsContinue && (
              <button type="button" class="quiz__btn" data-quiz-next disabled>
                <span>{content.continueLabel}</span>
                <svg class="quiz__arrow" width="40" height="25" viewBox="0 0 40 25" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12.5h33"/><path d="m26.5 3 9.5 9.5-9.5 9.5"/></svg>
              </button>
            )}
          </div>
        );
      })}

      <div class="quiz__step quiz__step--contact" data-step="contact" data-kind="contact" data-index={steps.length + 1} hidden inert>
        <h2 class="quiz__question quiz__question--tight" id="q-contact" tabindex="-1" set:html={fmt(contact.question)} />
        <p class="quiz__sub" set:html={fmt(contact.sub)} />
        <div class="quiz__contact">
          {contact.fields.map((f) => (
            <div class="quiz__field" data-field={f.name}>
              <label class="visually-hidden" for={`c-${f.name}`}>{f.label}</label>
              <input
                class="quiz__input"
                id={`c-${f.name}`}
                name={f.name}
                type={f.type}
                placeholder={f.placeholder}
                autocomplete={f.autocomplete ?? (f.type === 'tel' ? 'tel' : f.type === 'email' ? 'email' : 'off')}
                inputmode={f.type === 'tel' ? 'tel' : undefined}
                aria-describedby={`ce-${f.name}`}
                required={f.required}
              />
              <p class="quiz__error" id={`ce-${f.name}`} aria-live="polite"></p>
            </div>
          ))}
          <div class="quiz__hp" aria-hidden="true">
            <label for="c-company_website">Leave this field empty</label>
            <input id="c-company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
          </div>
        </div>
        <button type="submit" class="quiz__btn quiz__btn--submit" data-quiz-submit>
          <span>{contact.submitLabel}</span>
          <svg class="quiz__arrow" width="40" height="25" viewBox="0 0 40 25" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 12.5h33"/><path d="m26.5 3 9.5 9.5-9.5 9.5"/></svg>
        </button>
        <p class="quiz__error quiz__error--form" role="alert" data-quiz-form-error></p>
      </div>
    </form>
  </div>

  {loader.enabled && (
    <div class="quiz-loader" data-quiz-loader role="status" aria-live="polite" hidden>
      <div class="quiz-loader__inner">
        <div class="quiz-loader__tank" aria-hidden="true"><span class="quiz-loader__level"></span></div>
        <p class="quiz-loader__pct" data-loader-pct>0%</p>
        <ul class="quiz-loader__lines">
          {loader.lines.map((line) => (
            <li>
              <span class="quiz-loader__dot" aria-hidden="true"><Icon ui="check" size={12} strokeWidth={3.5} /></span>
              {line}
            </li>
          ))}
        </ul>
        <p class="quiz-loader__done">{loader.doneLine}</p>
      </div>
    </div>
  )}

  {exitPrompt && exitPrompt.headline && (
    <dialog class="quiz-exit" data-quiz-exit aria-labelledby="quiz-exit-title">
      <button class="quiz-exit__close" type="button" data-quiz-exit-close aria-label="Close">
        <Icon ui="close" size={20} strokeWidth={2} />
      </button>
      <div class="quiz-exit__bar" aria-hidden="true"><span data-quiz-exit-bar></span></div>
      <h2 class="quiz-exit__title" id="quiz-exit-title">{exitPrompt.headline}</h2>
      <p class="quiz-exit__body">{exitPrompt.body}</p>
      <ImageSlot image={exitPrompt.image} slotId="quiz.exitPrompt.image" spec={imageSpecs.exitPromptImage} description="optional picture for the exit prompt" placeholder={false} widths={[580, 1160]} sizes="(min-width: 1024px) 580px, 80vw" class="quiz-exit__image" />
      <button class="quiz__btn quiz-exit__cta" type="button" data-quiz-exit-close autofocus>
        <span>{exitPrompt.cta}</span>
      </button>
      {exitPrompt.disclaimer && <p class="quiz-exit__disclaimer">{exitPrompt.disclaimer}</p>}
    </dialog>
  )}
</section>

<script>
  import { initQuiz } from '../scripts/quiz.ts';
  initQuiz();
</script>

<style>
  /* Measured from reference C at 390 (base) and 1440 (media query). See docs/teardown-c.md. */
  .quiz {
    --q-pad: 15px;
    --q-question: 27px;
    --q-body: 18px;
    --q-control-h: 60px;
    --q-col: 520px;
    position: relative;
    background: var(--colour-surface-muted);
    color: var(--colour-body);
    font-family: var(--font-body);
    padding: 28px 0 60px;
    min-height: calc(100svh - var(--funnel-bar-h, 50px));
  }

  .quiz__inner {
    width: 100%;
    max-width: 1170px;
    margin-inline: auto;
    padding-inline: var(--q-pad);
  }

  /* ---- Progress dots ---- */
  .quiz__progress {
    display: flex;
    list-style: none;
    margin: 0 auto 28px;
    padding: 0 0 4px;
    max-width: 600px;
  }

  .quiz__progress li {
    position: relative;
    flex: 1 1 0;
    height: 20px;
    margin: 0;
    padding: 0;
  }

  .quiz__progress li::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 20px;
    height: 20px;
    margin-left: -10px;
    border-radius: 50%;
    background: var(--q-dot, #c7c7c7);
    z-index: 2;
    transition: background-color 0.3s;
  }

  .quiz__progress li::after {
    content: '';
    position: absolute;
    left: -50%;
    top: 8.5px;
    width: 100%;
    height: 3px;
    background: var(--q-dot, #c7c7c7);
    z-index: 1;
    transition: background-color 0.3s;
  }

  .quiz__progress li:first-child::after {
    content: none;
  }

  .quiz__progress li.is-lit::before,
  .quiz__progress li.is-lit::after {
    background: var(--colour-primary);
  }

  /* ---- Steps ---- */
  .quiz__step {
    text-align: center;
    transition: opacity 0.45s 0.2s, transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s;
  }

  .quiz__step[hidden] {
    display: none;
  }

  .quiz__step.is-entering,
  .quiz__step.is-leaving {
    opacity: 0;
    transform: translateY(12px);
  }

  .quiz__step.is-leaving {
    transition: opacity 0.2s, transform 0.2s;
  }

  .quiz__eyebrow {
    margin: 0 0 19px;
    font-size: 18px;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--colour-body);
  }

  .quiz__headline {
    margin: 0 0 30px;
    font-family: var(--font-display, var(--font-heading));
    font-weight: 400;
    font-size: 37px;
    line-height: 0.94;
    letter-spacing: var(--q-headline-tracking, 0);
    text-transform: uppercase;
    color: var(--colour-heading);
    text-wrap: balance;
  }

  .quiz__lede {
    margin: 0;
    font-size: var(--q-body);
    line-height: 1.5;
  }

  .quiz__pill {
    display: table;
    margin: 0 auto 17px;
    padding: 8px 14px;
    background: var(--colour-surface);
    border-radius: 47px;
    box-shadow: 1px 2px 3px rgb(0 0 0 / 0.08);
    font-size: 11px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--colour-body);
  }

  .quiz__pill::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--colour-danger);
    vertical-align: -1px;
  }

  .quiz__question {
    margin: 0 auto 28px;
    font-family: var(--font-body);
    font-size: var(--q-question);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--colour-heading);
    text-wrap: balance;
    /* A line break typed in config (\n) is kept, as the reference breaks some questions by hand. */
    white-space: pre-line;
  }

  .quiz__question:focus {
    outline: none;
  }

  .quiz__question--tight {
    margin-bottom: 12px;
  }

  .quiz__sub {
    margin: 0 auto 28px;
    font-size: var(--q-body);
    line-height: 1.5;
  }

  .quiz__note {
    margin: 0 auto 28px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--q-note, #595959);
  }

  .quiz__sub + .quiz__note {
    margin-top: -16px;
  }

  .quiz__sub :global([data-quiz-name]),
  .quiz__pill :global([data-quiz-name]) {
    font-weight: 600;
    color: var(--colour-heading);
  }

  /* ---- Inputs ---- */
  .quiz__field {
    max-width: var(--q-col);
    margin-inline: auto;
    text-align: left;
  }

  .quiz__input,
  .quiz__textarea {
    display: block;
    width: 100%;
    height: var(--q-control-h);
    padding: 0 24px;
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: 10px;
    box-shadow: 0 0 0 3px var(--q-ring, #ebebeb);
    font: 400 22px/1.5 var(--font-body);
    color: var(--colour-heading);
    transition: border-color 0.15s, box-shadow 0.15s;
    appearance: none;
  }

  .quiz__input::placeholder,
  .quiz__textarea::placeholder {
    color: var(--colour-placeholder);
    opacity: 1;
  }

  .quiz__input:focus-visible,
  .quiz__textarea:focus-visible {
    outline: none;
    border-color: var(--colour-heading);
    box-shadow: 0 0 0 3px var(--q-ring-focus, #d9d9d9);
  }

  .quiz__field.is-invalid .quiz__input,
  .quiz__field.is-invalid .quiz__textarea {
    border-color: var(--colour-danger);
    box-shadow: none;
  }

  .quiz__error {
    margin: 0;
    padding-left: 4px;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 500;
    color: var(--colour-danger);
  }

  .quiz__error:not(:empty) {
    margin-top: 6px;
  }

  .quiz__error--form {
    text-align: center;
    max-width: var(--q-col);
    margin-inline: auto;
  }

  .quiz__error--form:not(:empty) {
    margin-top: 12px;
  }

  .quiz__field--wide {
    max-width: 680px;
  }

  .quiz__textarea-wrap {
    position: relative;
  }

  .quiz__textarea {
    height: 290px;
    padding: 18px 24px 76px;
    font-size: 18px;
    line-height: 1.5;
    resize: none;
  }

  .quiz__dictate {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100% - 32px);
    min-height: 44px;
    padding: 4px 16px 4px 4px;
    background: var(--colour-surface);
    border: 1px solid #e6e6e6;
    border-radius: 22px;
    font: 500 15px/1.3 var(--font-body);
    color: #333;
    text-align: left;
    cursor: pointer;
  }

  .quiz__dictate[hidden] {
    display: none;
  }

  .quiz__dictate-mic {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--colour-primary);
    color: var(--colour-on-primary);
  }

  .quiz__dictate.is-listening .quiz__dictate-mic {
    background: var(--colour-danger);
    color: #fff;
  }

  .quiz__dictate-timer:empty {
    display: none;
  }

  .quiz__select-wrap {
    position: relative;
  }

  .quiz__select {
    padding-right: 52px;
    font-weight: 500;
    text-overflow: ellipsis;
    cursor: pointer;
  }

  .quiz__select-wrap :global(.quiz__select-chevron) {
    position: absolute;
    right: 20px;
    top: 50%;
    margin-top: -10px;
    color: var(--colour-heading);
    pointer-events: none;
  }

  .quiz__other {
    margin-top: 16px;
  }

  .quiz__other[hidden] {
    display: none;
  }

  /* ---- Buttons ---- */
  .quiz__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    max-width: var(--q-col);
    min-height: 65px;
    margin: 20px auto 0;
    padding: 15px 20px;
    background: var(--colour-primary);
    color: var(--colour-on-primary);
    border: 0;
    border-radius: 10px;
    box-shadow: 1px 8px 30px rgb(0 0 0 / 0.03), 1px 4px 10px rgb(0 0 0 / 0.05);
    font: 600 23px/1 var(--font-body);
    text-align: center;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s;
    -webkit-tap-highlight-color: transparent;
  }

  .quiz__btn--start {
    margin-top: 26px;
  }

  .quiz__btn--submit {
    font-size: 20px;
  }

  .quiz__btn .quiz__arrow {
    flex: none;
    width: 40px;
    height: 25px;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    animation: quiz-nudge 1.8s ease-in-out infinite;
  }

  .quiz__btn:disabled {
    background: var(--q-disabled, #c7c7c7);
    color: var(--q-disabled-text, #5c5c5c);
    cursor: not-allowed;
  }

  .quiz__btn:disabled .quiz__arrow {
    animation: none;
    opacity: 0.5;
  }

  @media (hover: hover) {
    .quiz__btn:not(:disabled):hover {
      background: var(--colour-primary-hover);
      transform: translateY(-3px);
      box-shadow: 0 14px 28px -10px color-mix(in srgb, var(--colour-primary) 55%, #000 20%), 0 4px 10px rgb(0 0 0 / 0.06);
    }

    .quiz__btn:not(:disabled):hover .quiz__arrow {
      transform: translateX(5px);
    }
  }

  .quiz__btn:not(:disabled):active {
    transform: translateY(1px) scale(0.98);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.08);
    transition-duration: 0.08s;
  }

  .quiz__btn:focus-visible,
  .quiz__dictate:focus-visible {
    outline: 3px solid var(--colour-focus);
    outline-offset: 3px;
  }

  @keyframes quiz-nudge {
    0%, 60%, 100% { translate: 0 0; }
    30% { translate: 5px 0; }
  }

  /* ---- Options: shared ---- */
  .quiz__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .quiz__radio:focus-visible + label {
    outline: 3px solid var(--colour-focus);
    outline-offset: 3px;
  }

  .quiz-card,
  .quiz-pill,
  .quiz-tick,
  .quiz-num,
  .quiz-emoji,
  .quiz-offer {
    position: relative;
  }

  /* ---- Option cards ---- */
  .quiz__cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 560px;
    margin-inline: auto;
  }

  .quiz-card label {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 96px;
    padding: 18px 24px 18px 18px;
    background: var(--colour-surface);
    border: 2px solid var(--colour-surface);
    border-radius: 10px;
    box-shadow: 1px 2px 3px rgb(0 0 0 / 0.08);
    text-align: left;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s, background-color 0.2s;
  }

  .quiz-card__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 10px;
    background: #f3f4f5;
    color: #1a1a1a;
    transition: background-color 0.2s, color 0.2s;
  }

  .quiz-card__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .quiz-card__title {
    font-size: 21px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--colour-heading);
  }

  .quiz-card__desc {
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--q-desc, #636363);
  }

  .quiz-card :global(.quiz-card__chevron) {
    flex: none;
    color: #8a8a8a;
    transition: transform 0.2s, color 0.2s;
  }

  .quiz-card .quiz__radio:checked + label,
  .quiz-card .quiz__radio:focus-visible + label {
    background: color-mix(in srgb, var(--colour-primary) 8%, #fff);
    border-color: var(--colour-primary);
    box-shadow: 1px 8px 16px rgb(0 0 0 / 0.08);
  }

  .quiz-card .quiz__radio:checked + label .quiz-card__icon {
    background: var(--colour-primary);
    color: var(--colour-on-primary);
  }

  @media (hover: hover) {
    .quiz-card label:hover {
      background: color-mix(in srgb, var(--colour-primary) 8%, #fff);
      border-color: var(--colour-primary);
      box-shadow: 1px 8px 16px rgb(0 0 0 / 0.08);
      transform: translateY(-2px);
    }

    .quiz-card label:hover .quiz-card__icon {
      background: var(--colour-primary);
      color: var(--colour-on-primary);
    }

    .quiz-card label:hover :global(.quiz-card__chevron) {
      color: #000;
      transform: translateX(3px);
    }
  }

  /* ---- Radio pills ---- */
  .quiz__pills {
    display: grid;
    grid-template-columns: 1fr;
    gap: 13px 17px;
    max-width: 798px;
    margin-inline: auto;
  }

  .quiz-pill label {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 62px;
    padding: 12px 16px;
    background: var(--colour-surface);
    border-radius: 100px;
    box-shadow: 1px 2px 3px rgb(0 0 0 / 0.08);
    font-size: 20px;
    line-height: 1.2;
    font-weight: 500;
    color: var(--q-pill-text, #595959);
    text-align: left;
    cursor: pointer;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .quiz-pill__dot {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #eaeced;
    color: transparent;
    transition: background-color 0.2s, color 0.2s;
  }

  .quiz-pill .quiz__radio:checked + label .quiz-pill__dot {
    background: var(--colour-primary);
    color: var(--colour-on-primary);
  }

  @media (hover: hover) {
    .quiz-pill label:hover .quiz-pill__dot {
      background: var(--colour-primary);
      color: var(--colour-on-primary);
    }
  }

  /* ---- Multi-select pills ---- */
  .quiz__multi {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 1022px;
    margin-inline: auto;
  }

  .quiz-tick label {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 70px;
    padding: 0 20px 0 14px;
    background: var(--colour-surface);
    border: 2px solid #dcdcdc;
    border-radius: 100px;
    font-size: 19px;
    line-height: 1.2;
    font-weight: 500;
    color: #4a4a4a;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .quiz-tick__icons {
    flex: none;
    display: flex;
  }

  .quiz-tick__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #dcdcdc;
    box-shadow: 0 0 0 2px #fff;
    color: #1a1a1a;
  }

  .quiz-tick__icon + .quiz-tick__icon {
    margin-left: -12px;
  }

  .quiz-tick__label {
    flex: 1;
  }

  .quiz-tick__check {
    flex: none;
    display: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #fff;
    color: #000;
  }

  .quiz-tick .quiz__radio:checked + label {
    background: var(--colour-primary);
    border-color: var(--colour-primary);
    color: var(--colour-on-primary);
    box-shadow: 1px 2px 3px rgb(0 0 0 / 0.08);
  }

  .quiz-tick .quiz__radio:checked + label .quiz-tick__check {
    display: flex;
  }

  @media (hover: hover) {
    .quiz-tick .quiz__radio:not(:checked) + label:hover {
      background: color-mix(in srgb, var(--colour-primary) 8%, #fff);
      border-color: var(--colour-primary);
      box-shadow: 1px 6px 12px rgb(0 0 0 / 0.06);
    }
  }

  .quiz__step--multi .quiz__btn {
    margin-top: 44px;
  }

  .quiz__step--longtext .quiz__btn {
    margin-top: 24px;
    max-width: 680px;
  }

  /* ---- Scale ---- */
  .quiz__scale {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    max-width: 798px;
    margin-inline: auto;
  }

  .quiz-num label {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    border-radius: 100px;
    box-shadow: 1px 2px 3px rgb(0 0 0 / 0.08);
    font-size: 20px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .quiz-num .quiz__radio:checked + label {
    box-shadow: 0 0 0 2px #000;
  }

  @media (hover: hover) {
    .quiz-num label:hover {
      transform: translateY(-2px);
    }
  }

  /* ---- Yes / no cards ---- */
  .quiz__yesno {
    display: flex;
    justify-content: center;
    gap: 16px;
  }

  .quiz-emoji label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 135px;
    min-height: 160px;
    padding: 24px 20px;
    background: var(--colour-surface);
    border: 2px solid var(--colour-surface);
    border-radius: 10px;
    box-shadow: 1px 10px 15px rgb(0 0 0 / 0.02), 1px 2px 3px rgb(0 0 0 / 0.06);
    font-size: 20px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--q-pill-text, #595959);
    cursor: pointer;
    transition: border-color 0.2s, transform 0.2s;
  }

  .quiz-emoji__glyph {
    font-size: 60px;
    line-height: 1.5;
  }

  .quiz-emoji .quiz__radio:checked + label {
    border-color: var(--colour-primary);
  }

  @media (hover: hover) {
    .quiz-emoji label:hover {
      border-color: var(--colour-primary);
      transform: translateY(-2px);
    }
  }

  /* ---- Offer cards ---- */
  .quiz__offers {
    display: grid;
    grid-template-columns: 1fr;
    gap: 72px;
    max-width: 1086px;
    margin-inline: auto;
    padding-top: 52px;
  }

  .quiz-offer label {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    padding: 36px 20px 28px;
    background: var(--colour-surface);
    border: 1px solid #e6e6e6;
    border-radius: 22px;
    box-shadow: 1px 2px 6px rgb(0 0 0 / 0.08);
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  /* The dark disc that overlaps the top edge of each card (the reference puts its brand mark in it). */
  .quiz-offer__mark {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    margin-top: -84px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--colour-heading);
    color: var(--colour-primary);
  }

  .quiz-offer__eyebrow {
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--colour-accent-text);
  }

  .quiz-offer__title {
    padding-top: 8px;
    font-family: var(--font-display, var(--font-heading));
    font-weight: 400;
    font-size: 60px;
    line-height: 1.13;
    letter-spacing: var(--q-headline-tracking, 0);
    text-transform: uppercase;
    color: var(--colour-heading);
  }

  .quiz-offer__desc {
    padding: 22px 0 28px;
    font-size: 16.8px;
    line-height: 1.6;
    text-align: left;
    color: #555;
  }

  .quiz-offer__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 64px;
    margin-top: auto;
    background: var(--colour-primary);
    color: var(--colour-on-primary);
    border-radius: 6px;
    font-size: 21px;
    font-weight: 600;
  }

  .quiz-offer__proof {
    display: block;
    width: 250px;
    max-width: 100%;
    margin-top: 26px;
  }

  .quiz-offer__line {
    margin-top: 16px;
    font-size: 15px;
    line-height: 1.5;
    color: #555;
  }

  .quiz-offer .quiz__radio:checked + label {
    border-color: var(--colour-primary);
    box-shadow: 0 0 0 1px var(--colour-primary), 1px 2px 6px rgb(0 0 0 / 0.08);
  }

  /* ---- Contact step ---- */
  .quiz__contact {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: var(--q-col);
    margin-inline: auto;
  }

  .quiz__contact .quiz__field {
    width: 100%;
  }

  .quiz__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ---- Loader ---- */
  .quiz-loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 15px;
    background: var(--colour-surface);
    --p: 0;
  }

  .quiz-loader[hidden] {
    display: none;
  }

  .quiz-loader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 360px;
  }

  .quiz-loader__tank {
    position: relative;
    width: 96px;
    height: 108px;
    border-radius: 18px;
    background: #ececec;
    overflow: hidden;
  }

  .quiz-loader__level {
    position: absolute;
    left: -25%;
    width: 150%;
    height: 130%;
    top: calc(100% - var(--p) * 108%);
    background: var(--colour-primary);
    border-radius: 42% 46% 0 0 / 14px 18px 0 0;
    transition: top 0.25s linear;
    animation: quiz-wave 1.6s linear infinite;
  }

  .quiz-loader__pct {
    margin: 32px 0 0;
    font: 600 40px/1 var(--font-body);
    color: var(--colour-heading);
    font-variant-numeric: tabular-nums;
  }

  .quiz-loader__lines {
    list-style: none;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 32px 0 0;
    padding: 0;
  }

  .quiz-loader__lines li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 500;
    color: #737373;
    transition: color 0.3s;
  }

  .quiz-loader__dot {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid #e2e2e2;
    color: transparent;
  }

  .quiz-loader__lines li.is-on,
  .quiz-loader__lines li.is-done {
    color: var(--colour-heading);
  }

  .quiz-loader__lines li.is-on .quiz-loader__dot {
    border-color: var(--colour-primary);
    border-top-color: transparent;
    animation: quiz-spin 0.8s linear infinite;
  }

  .quiz-loader__lines li.is-done .quiz-loader__dot {
    background: var(--colour-primary);
    border-color: var(--colour-primary);
    color: var(--colour-on-primary);
  }

  .quiz-loader__done {
    margin: 34px 0 0;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--colour-heading);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s, transform 0.35s;
  }

  .quiz-loader.is-complete .quiz-loader__done {
    opacity: 1;
    transform: none;
  }

  @keyframes quiz-wave {
    0%, 100% { border-radius: 42% 46% 0 0 / 14px 18px 0 0; }
    50% { border-radius: 46% 40% 0 0 / 18px 12px 0 0; }
  }

  @keyframes quiz-spin {
    to { rotate: 360deg; }
  }

  /* ---- Exit prompt ---- */
  .quiz-exit {
    inset: 0;
    margin: auto;
    width: min(900px, calc(100vw - 40px));
    max-height: calc(100vh - 80px);
    padding: 35px 30px 45px;
    border: 0;
    border-radius: 8px;
    background: var(--colour-surface);
    color: var(--colour-body);
    text-align: center;
    overflow: auto;
  }

  .quiz-exit::backdrop {
    background: rgb(40 39 40 / 0.8);
  }

  .quiz-exit__close {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: 0;
    color: var(--colour-heading);
    cursor: pointer;
  }

  .quiz-exit__bar {
    width: min(560px, 100%);
    height: 30px;
    margin: 0 auto 30px;
    padding: 4px;
    border-radius: 100px;
    background: #d9d9d9;
  }

  .quiz-exit__bar span {
    display: block;
    width: 15%;
    height: 100%;
    border-radius: 100px;
    background: var(--colour-primary);
    transition: width 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .quiz-exit__title {
    margin: 0 0 20px;
    font-family: var(--font-display, var(--font-heading));
    font-weight: 400;
    font-size: clamp(36px, 6vw, 70px);
    line-height: 1;
    letter-spacing: var(--q-headline-tracking, 0);
    text-transform: uppercase;
    color: var(--colour-heading);
  }

  .quiz-exit__body {
    max-width: 650px;
