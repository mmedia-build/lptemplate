---
/**
 * Review proof badge. Hidden entirely when proof.rating or proof.count is
 * empty, so layouts close up with no gap. Two variants: "inline" (one line,
 * under CTAs) and "stacked" (source mark, stars and avatars over the text,
 * above section headings).
 */
import { site, hasProof } from '../lib/site.ts';
import Stars from './Stars.astro';
import ImageSlot from './ImageSlot.astro';
import { imageSpecs } from '../tokens/tokens.ts';

interface Props {
  variant?: 'inline' | 'stacked';
  class?: string;
}
const { variant = 'inline', class: cls } = Astro.props;
const { rating, count, source, avatars } = site.proof;
const isGoogle = /google/i.test(source);
---

{hasProof && (
  <div class:list={['badge', `badge--${variant}`, cls]}>
    <span class="badge__marks">
      {isGoogle ? (
        <svg class="badge__source" viewBox="0 0 24 24" width="18" height="18" aria-label="Google" role="img">
          <path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.8 3-4.3 3-7.4Z" />
          <path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z" />
          <path fill="#FBBC05" d="M6.4 14a6 6 0 0 1 0-3.9V7.5H3.1a10 10 0 0 0 0 9l3.3-2.5Z" />
          <path fill="#EA4335" d="M12 6c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 3.1 7.5L6.4 10c.8-2.3 3-4 5.6-4Z" />
        </svg>
      ) : (
        <span class="badge__source-text">{source}</span>
      )}
      <Stars size={18} />
      {variant === 'stacked' && avatars.src && (
        <ImageSlot image={avatars} slotId="proof.avatars" spec={imageSpecs.avatars} description="" widths={[164]} sizes="82px" class="badge__avatars" placeholder={false} />
      )}
    </span>
    <p class="badge__text">
      <strong>{rating} Stars</strong> From {count} {source} Reviews
    </p>
  </div>
)}

<style>
  .badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-inline);
    color: var(--colour-body);
  }

  .badge__marks {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-inline);
  }

  .badge__source {
    flex: none;
  }

  .badge__source-text {
    font-size: var(--fs-caption);
    font-weight: var(--weight-bold);
  }

  .badge__text {
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    white-space: nowrap;
  }

  .badge__text strong {
    font-weight: var(--weight-bold);
  }

  .badge--stacked {
    flex-direction: column;
    gap: 8px;
  }

  .badge--stacked .badge__text {
    font-size: var(--fs-small);
    line-height: 1.4;
  }

  .badge__avatars {
    width: 68px;
    height: 20px;
  }

  @media (min-width: 1024px) {
    .badge--stacked .badge__marks {
      gap: 16px;
    }

    .badge--stacked .badge__text {
      font-size: 18px;
    }

    .badge__avatars {
      width: 82px;
      height: 24px;
    }
  }
</style>
