---
/**
 * Inline SVG icon. `name` picks a config icon (src/icons/index.ts), `ui` picks
 * an interface glyph. Stroke icons inherit the text colour.
 */
import type { IconName } from '../config/types.ts';
import { iconMarkup, uiIcons } from '../icons/index.ts';

interface Props {
  name?: IconName;
  ui?: keyof typeof uiIcons;
  size?: number;
  class?: string;
  strokeWidth?: number;
  filled?: boolean;
  label?: string;
}

const { name, ui, size = 24, class: cls, strokeWidth = 1.75, filled = false, label } = Astro.props;
const markup = ui ? uiIcons[ui] : iconMarkup(name);
---

{markup && (
  <svg
    class={cls}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill={filled ? 'currentColor' : 'none'}
    stroke={filled ? 'none' : 'currentColor'}
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden={label ? undefined : 'true'}
    role={label ? 'img' : undefined}
    aria-label={label}
    focusable="false"
    set:html={markup}
  />
)}
