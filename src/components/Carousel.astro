---
/**
 * Native scroll-snap carousel: touch swipes, keyboard arrows on the focused
 * track, prev/next buttons and dots. Vertical page scroll is never trapped.
 */
interface Props {
  /** Slides visible at once on phones and desktop. */
  perView?: { mobile: number; desktop: number };
  gap?: string;
  label?: string;
  /**
   * 'pages' (default): slides snap to the start, dots per page (A, B).
   * 'centre': one slide centred with its neighbours peeking and dimmed, arrows only (reference C).
   */
  mode?: 'pages' | 'centre';
  /** Slide width in centre mode, for example { mobile: '80%', desktop: '540px' }. */
  slideWidth?: { mobile: string; desktop: string };
  dots?: boolean;
  class?: string;
}
const {
  perView = { mobile: 2, desktop: 4 },
  gap = '14px',
  label = 'Carousel',
  mode = 'pages',
  slideWidth = { mobile: '80%', desktop: '540px' },
  dots = mode === 'pages',
  class: cls,
} = Astro.props;
const style = `--per-mobile:${perView.mobile};--per-desktop:${perView.desktop};--carousel-gap:${gap};--slide-w-mobile:${slideWidth.mobile};--slide-w-desktop:${slideWidth.desktop};`;
---

<div class:list={['carousel', `carousel--${mode}`, !dots && 'carousel--no-dots', cls]} style={style} data-carousel data-carousel-mode={mode}>
  <div class="carousel__track" tabindex="0" role="region" aria-label={label} aria-roledescription="carousel" data-carousel-track>
    <slot />
  </div>
  <div class="carousel__controls">
    <button type="button" class="carousel__arrow" data-carousel-prev aria-label="Previous">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
    </button>
    <div class="carousel__dots" data-carousel-dots role="tablist" aria-label="Choose slide"></div>
    <button type="button" class="carousel__arrow" data-carousel-next aria-label="Next">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
    </button>
  </div>
</div>

<script>
  import { initCarousels } from '../scripts/carousel.ts';
  initCarousels();
</script>

<style>
  .carousel {
    width: 100%;
  }

  .carousel__track {
    display: flex;
    gap: var(--carousel-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    padding-bottom: 4px;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__track > :global(*) {
    flex: 0 0 calc((100% - (var(--per-mobile) - 1) * var(--carousel-gap)) / var(--per-mobile));
    scroll-snap-align: start;
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  .carousel__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border-radius: var(--radius-pill);
    color: var(--colour-heading);
    background: var(--colour-surface-muted);
  }

  .carousel__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .carousel__dots {
    display: flex;
    gap: 2px;
  }

  /* Each dot is an 8px mark inside a 24px target so the row passes the tap-target audit. */
  .carousel__dots :global(button) {
    position: relative;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: var(--radius-pill);
    background: transparent;
  }

  .carousel__dots :global(button::before) {
    content: '';
    position: absolute;
    top: 8px;
    left: 8px;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pill);
    background: rgb(0 0 0 / 0.2);
  }

  .carousel__dots :global(button[aria-selected='true']::before) {
    background: var(--colour-accent);
  }

  .carousel--no-dots .carousel__dots {
    display: none;
  }

  /* Centre mode (reference C): the current slide centred, neighbours peeking, smaller and dimmed. */
  /* Spacers either side (not padding) so percentage slide widths resolve against the full track width. */
  .carousel--centre .carousel__track {
    --slide-w: var(--slide-w-mobile);
  }

  .carousel--centre .carousel__track::before,
  .carousel--centre .carousel__track::after {
    content: '';
    flex: 0 0 calc((100% - var(--slide-w)) / 2 - var(--carousel-gap));
  }

  .carousel--centre .carousel__track > :global(*) {
    flex: 0 0 var(--slide-w);
    scroll-snap-align: center;
    transition: transform 280ms var(--ease-out), opacity 280ms var(--ease-out);
  }

  /* Neighbours are smaller and only slightly dimmed: any more and their text drops under 4.5:1 (reference C blurs them to 48%). */
  .carousel--centre .carousel__track > :global(:not(.is-current)) {
    transform: scale(0.92);
    opacity: 0.9;
  }

  .carousel--centre .carousel__arrow {
    background: var(--colour-surface);
    border: 1px solid var(--colour-card-border, rgb(0 0 0 / 0.12));
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel--centre .carousel__track > :global(*) {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .carousel__track > :global(*) {
      flex-basis: calc((100% - (var(--per-desktop) - 1) * var(--carousel-gap)) / var(--per-desktop));
    }

    .carousel--centre .carousel__track {
      --slide-w: var(--slide-w-desktop);
    }

    .carousel--centre .carousel__track > :global(*) {
      flex-basis: var(--slide-w);
    }
  }
</style>
