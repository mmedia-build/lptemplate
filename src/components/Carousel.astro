---
/**
 * Native scroll-snap carousel: touch swipes, keyboard arrows on the focused
 * track, prev/next buttons and dots. Vertical page scroll is never trapped.
 */
interface Props {
  /** Slides visible at once on phones and desktop. */
  perView?: { mobile: number; desktop: number };
  gap?: string;
  label?: string;
  class?: string;
}
const { perView = { mobile: 2, desktop: 4 }, gap = '14px', label = 'Carousel', class: cls } = Astro.props;
const style = `--per-mobile:${perView.mobile};--per-desktop:${perView.desktop};--carousel-gap:${gap};`;
---

<div class:list={['carousel', cls]} style={style} data-carousel>
  <div class="carousel__track" tabindex="0" role="region" aria-label={label} aria-roledescription="carousel" data-carousel-track>
    <slot />
  </div>
  <div class="carousel__controls">
    <button type="button" class="carousel__arrow" data-carousel-prev aria-label="Previous">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
    </button>
    <div class="carousel__dots" data-carousel-dots role="tablist" aria-label="Choose slide"></div>
    <button type="button" class="carousel__arrow" data-carousel-next aria-label="Next">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
    </button>
  </div>
</div>

<script>
  import { initCarousels } from '../scripts/carousel.ts';
  initCarousels();
</script>

<style>
  .carousel {
    width: 100%;
  }

  .carousel__track {
    display: flex;
    gap: var(--carousel-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    padding-bottom: 4px;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__track > :global(*) {
    flex: 0 0 calc((100% - (var(--per-mobile) - 1) * var(--carousel-gap)) / var(--per-mobile));
    scroll-snap-align: start;
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  .carousel__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border-radius: var(--radius-pill);
    color: var(--colour-heading);
    background: var(--colour-surface-muted);
  }

  .carousel__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .carousel__dots {
    display: flex;
    gap: 8px;
  }

  .carousel__dots :global(button) {
    width: 8px;
    height: 8px;
    padding: 0;
    border-radius: var(--radius-pill);
    background: rgb(0 0 0 / 0.2);
  }

  .carousel__dots :global(button[aria-selected='true']) {
    background: var(--colour-accent);
  }

  @media (min-width: 1024px) {
    .carousel__track > :global(*) {
      flex-basis: calc((100% - (var(--per-desktop) - 1) * var(--carousel-gap)) / var(--per-desktop));
    }
  }
</style>
