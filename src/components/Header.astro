---
/**
 * Logo and click-to-call phone. No navigation. Sits over the hero photo when
 * the hero is the first section (as on the reference); otherwise it is a plain
 * white bar in the flow so the first section is never covered.
 */
import { site, telHref } from '../lib/site.ts';
import { imageSpecs } from '../tokens/tokens.ts';
import ImageSlot from './ImageSlot.astro';
import Icon from './Icon.astro';
import GuideNote from './GuideNote.astro';

interface Props {
  overlay?: boolean;
}
const { overlay = true } = Astro.props;
const { business } = site;
---

<header class:list={['header', overlay ? 'header--overlay' : 'header--solid']} id="top">
  <GuideNote type="header" />
  <div class="container header__inner">
    <a class="header__logo" href="#top">
      <ImageSlot
        image={business.logo}
        slotId="business.logo"
        spec={imageSpecs.logo}
        description="full colour logo"
        loading="eager"
        priority
        widths={[150, 300, 440]}
        sizes="(min-width: 1024px) 150px, 100px"
        class="header__logo-img"
      />
    </a>
    <a class="header__phone" href={telHref}>
      <Icon ui="phone" size={32} class="header__phone-icon" filled />
      <span class="header__phone-text">
        <span class="header__phone-eyebrow">{business.phoneEyebrow}</span>
        <span class="header__phone-number">{business.phoneDisplay}</span>
      </span>
      <span class="visually-hidden">Call {business.name}</span>
    </a>
  </div>
</header>

{site.header.stickyPhoneButton && (
  <a class="sticky-phone" href={telHref} aria-label={`Call ${business.name}`}>
    <Icon ui="phone" size={26} filled />
  </a>
)}

<style>
  .header {
    width: 100%;
    padding-top: var(--header-pad);
    padding-bottom: var(--header-pad);
    z-index: 10;
  }

  .header--overlay {
    position: absolute;
    top: 0;
    left: 0;
    background: transparent;
  }

  .header--solid {
    position: relative;
    background: var(--colour-surface);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .header__logo {
    display: block;
    width: 100px;
    height: var(--header-logo-h);
    flex: none;
  }

  .header__logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .header__phone {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    margin-right: -6px;
    color: var(--colour-body);
    text-decoration: none;
  }

  .header__phone-icon {
    flex: none;
  }

  .header__phone-text {
    display: none;
    flex-direction: column;
    gap: 2px;
  }

  .header__phone-eyebrow {
    font-size: var(--fs-header-eyebrow);
    line-height: 1;
    font-weight: var(--weight-medium);
  }

  .header__phone-number {
    font-size: var(--fs-header-phone);
    line-height: 1;
    font-weight: var(--weight-semibold);
    letter-spacing: -0.04em;
    color: var(--colour-body-strong);
  }

  .sticky-phone {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-pill);
    background: var(--colour-primary);
    color: var(--colour-on-primary);
    box-shadow: var(--shadow-step-image);
  }

  @media (min-width: 1024px) {
    .header__logo {
      width: 150px;
    }

    .header__phone-text {
      display: flex;
    }

    .header__phone {
      margin-right: 0;
    }

    .sticky-phone {
      display: none;
    }
  }
</style>
