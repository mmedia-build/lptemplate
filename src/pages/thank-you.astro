---
/**
 * Thank-you route. Fires the Meta Lead event once, only after a real submit.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import Icon from '../components/Icon.astro';
import { site, telHref } from '../lib/site.ts';

const { thankYou, business } = site;
---

<Base title={thankYou.seoTitle} description={site.seo.description}>
  <Header overlay={false} />
  <main>
    <section class="thanks section tone-light">
      <Container narrow>
        <div class="thanks__inner">
          <h1 class="thanks__headline">{thankYou.headline}</h1>
          <h2 class="h2 thanks__sub">{thankYou.subheadline}</h2>
          <ol class="thanks__steps">
            {thankYou.steps.map((step, i) => (
              <li class="thanks__step">
                <span class="thanks__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="thanks__step-title">{step.title}</h3>
                  <p class="thanks__step-body">{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="thanks__phone-label">{thankYou.phoneLabel}</p>
          <a class="btn thanks__call" href={telHref}>
            <Icon ui="phone" size={22} filled class="thanks__call-icon" />
            {business.phoneDisplay}
          </a>
        </div>
      </Container>
    </section>
  </main>
  <Footer />
  <script>
    import { fireLeadOnce } from '../lib/tracking.ts';
    fireLeadOnce();
  </script>
</Base>

<style>
  .thanks {
    padding-top: 60px;
    padding-bottom: 80px;
  }

  .thanks__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .thanks__headline {
    font-size: 36px;
    line-height: 1.1;
    font-weight: var(--weight-bold);
    letter-spacing: -0.02em;
  }

  .thanks__steps {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 8px;
  }

  .thanks__step {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    align-items: start;
  }

  .thanks__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--colour-accent-strong);
    color: #fff;
    font-size: 14px;
    font-weight: var(--weight-bold);
  }

  .thanks__step-title {
    font-size: 18px;
    line-height: 1.2;
    font-weight: var(--weight-semibold);
    margin-bottom: 4px;
  }

  .thanks__phone-label {
    margin-top: 8px;
    font-weight: var(--weight-semibold);
    color: var(--colour-heading);
  }

  .thanks__call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    text-transform: none;
    letter-spacing: 0.01em;
  }

  @media (min-width: 1024px) {
    .thanks {
      padding-top: 100px;
      padding-bottom: 120px;
    }

    .thanks__call {
      width: auto;
      min-width: 320px;
    }
  }
</style>
